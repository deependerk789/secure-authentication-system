# Copy to .env and adjust. Never commit the real .env file.

# Required in production (PRODUCTION=1). At least 32 random characters.
SECRET_KEY=

# Set to 1 when serving over HTTPS.
PRODUCTION=0

# Development server
FLASK_DEBUG=0
PORT=5000

# Storage
DATABASE_PATH=

# Session and lockout policy
SESSION_LIFETIME_MINUTES=30
IDLE_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
TWO_FACTOR_WINDOW=1

# Outgoing e-mail. Leave MAIL_SERVER empty to run in development mode,
# where messages are written to data/outbox and the link is shown in the UI.
MAIL_PORT=465
MAIL_USERNAME=devilkillerwing@gmail.com
MAIL_PASSWORD=Deepender789@123
MAIL_USE_TLS=0
MAIL_FROM=devlikillerwing@gmail.com
